{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Tally": "Data Source=tally.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "Jwt": {
    "Issuer": "tally",
    "Audience": "tally-api",
    "Lifetime": "01:00:00"
  },
  "RateLimiting": {
    "LoginPermitsPerMinute": 10
  }
}
