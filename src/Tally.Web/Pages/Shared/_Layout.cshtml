@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Tally</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" asp-page="/Index">Tally</a>
    <nav>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Claims/Index">My claims</a>
            @if (User.IsInRole(nameof(UserRole.Approver)))
            {
                <a asp-page="/Reviews/Index">Review queue</a>
            }
            @if (Env.IsDevelopment())
            {
                <a href="/scalar">API docs</a>
            }
            <form method="post" asp-page="/Account/Logout" class="inline">
                <button type="submit" class="link">Sign out @User.Identity.Name</button>
            </form>
        }
        else
        {
            <a asp-page="/Account/Login">Sign in</a>
        }
    </nav>
</header>
<main class="container">
    @if (TempData["Flash"] is string flash)
    {
        <p class="flash">@flash</p>
    }
    @RenderBody()
</main>
</body>
</html>
