@page
@model Tally.Web.Pages.Claims.IndexModel
@{
    ViewData["Title"] = "My claims";
}
<h1>My claims</h1>

<details class="card" open="@(Model.Claims.TotalCount == 0 || !ModelState.IsValid)">
    <summary>Submit a new claim</summary>
    <form method="post" asp-page-handler="Submit" class="grid">
        <div asp-validation-summary="All" class="errors"></div>
        <label class="wide">Description <input asp-for="Input.Description" /></label>
        <label>Category
            <select asp-for="Input.Category" asp-items="Html.GetEnumSelectList<ExpenseCategory>()">
                <option value="">Choose…</option>
            </select>
        </label>
        <label>Amount <input asp-for="Input.Amount" type="number" step="0.01" min="0.01" /></label>
        <label>Currency <input asp-for="Input.Currency" maxlength="3" /></label>
        <label>Date incurred <input asp-for="Input.IncurredOn" type="date" /></label>
        <button type="submit" class="button">Submit</button>
    </form>
</details>

@if (Model.Claims.TotalCount == 0)
{
    <p class="empty">No claims yet.</p>
}
else
{
    <table>
        <thead>
        <tr><th>Date</th><th>Description</th><th>Category</th><th class="num">Amount</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var claim in Model.Claims.Items)
        {
            <tr>
                <td>@claim.IncurredOn.ToString("yyyy-MM-dd")</td>
                <td>@claim.Description
                    @if (claim.ReviewNote is not null)
                    {
                        <div class="note">@claim.ReviewNote</div>
                    }
                </td>
                <td>@claim.Category</td>
                <td class="num">@claim.Amount.ToString("N2") @claim.Currency</td>
                <td><span class="status status-@claim.Status.ToString().ToLowerInvariant()">@claim.Status</span></td>
                <td>
                    @if (claim.Status == ClaimStatus.Submitted)
                    {
                        <form method="post" asp-page-handler="Withdraw" asp-route-id="@claim.Id" class="inline">
                            <button type="submit" class="link">Withdraw</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    <partial name="_Pager" model="Model.Claims" />
}
